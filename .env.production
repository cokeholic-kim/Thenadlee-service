# 운영 빌드(npm run build) 환경변수. GitHub Actions 빌드 시 이 파일 값이 사용됨
# 주의: REACT_APP_ 값은 빌드 결과 JS 에 그대로 포함되어 브라우저에서 누구나 볼 수 있음
#       저장소가 public 이므로 키에는 반드시 사용 도메인 제한을 걸 것

# API / 정적 파일 경로 (같은 도메인 기준)
REACT_APP_API_URL=/back
REACT_APP_FILE_URL=/file

# Google Maps JavaScript API 키 (Google Cloud Console > API 및 서비스 > 사용자 인증 정보)
REACT_APP_GOOGLE_API_KEY=

# OpenWeatherMap API 키 (https://home.openweathermap.org/api_keys)
REACT_APP_WHEATHER_API_KEY=
REACT_APP_WHEATHER_BASE_URL=https://api.openweathermap.org/data/2.5/
