# 운영 빌드(npm run build) 공통 설정. 비밀값(API 키)은 넣지 말 것
# API 키(REACT_APP_GOOGLE_API_KEY, REACT_APP_WHEATHER_API_KEY)는
# GitHub production environment 의 Secrets 에서 빌드 시 주입됨

# API / 정적 파일 경로 (같은 도메인 기준)
REACT_APP_API_URL=/back
REACT_APP_FILE_URL=/file

# OpenWeatherMap API 주소
REACT_APP_WHEATHER_BASE_URL=https://api.openweathermap.org/data/2.5/
