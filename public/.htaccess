# html/front/ 설정 (실제 서비스 주소는 도메인 루트, html/.htaccess 참고)
# ※ 운영 공유호스팅은 일부 모듈·지시어(mod_env 의 SetEnv, ForceType, RemoveType 등)를 쓰면 폴더 전체가 500 오류가 남.
#    여기에는 운영에서 동작이 확인된 지시어(Options, DirectoryIndex, RewriteRule, FilesMatch, Header)만 쓸 것
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    # 사용자가 /front/... 주소로 직접 접속하면 도메인 루트 주소로 이동
    # (THE_REQUEST 는 브라우저의 원래 요청이라 루트에서 내부 재작성된 요청은 해당되지 않음)
    RewriteCond %{THE_REQUEST} \s/front/?([^\s?]*)
    RewriteRule ^ /%1 [R=301,L]
    # 미리 압축한 파일(.gz)은 서버 압축(mod_deflate)이 다시 압축하지 않게 표시
    RewriteRule \.gz$ - [E=no-gzip:1]
</IfModule>

# HTML(index.html, 미리 만든 페이지)·서비스 워커·manifest 는 항상 새로 받고, 해시가 붙은 정적 파일과 압축본(.gz)은 오래 캐시
# 미리 압축한 JS·CSS(.gz)는 gzip 인코딩으로 알려 줌 (파일 형식도 여기서 지정: 내부 이동을 거치면 RewriteRule 의 [T=] 는 적용되지 않음)
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(js|css|woff2?)(\.gz)?$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "^(service-worker\.js|manifest\.json)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.js\.gz$">
        Header set Content-Type "text/javascript; charset=utf-8"
        Header set Content-Encoding gzip
        Header append Vary Accept-Encoding
    </FilesMatch>
    <FilesMatch "\.css\.gz$">
        Header set Content-Type "text/css; charset=utf-8"
        Header set Content-Encoding gzip
        Header append Vary Accept-Encoding
    </FilesMatch>
</IfModule>
