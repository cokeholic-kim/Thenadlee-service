# html/front/ 설정 (실제 서비스 주소는 도메인 루트, html/.htaccess 참고)
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    # 사용자가 /front/... 주소로 직접 접속하면 도메인 루트 주소로 이동
    # (THE_REQUEST 는 브라우저의 원래 요청이라 루트에서 내부 재작성된 요청은 해당되지 않음)
    RewriteCond %{THE_REQUEST} \s/front/?([^\s?]*)
    RewriteRule ^ /%1 [R=301,L]
</IfModule>

# index.html 은 항상 새로 받고, 해시가 붙은 정적 파일은 오래 캐시
<IfModule mod_headers.c>
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(js|css|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
